{
  "_meta": {
    "description": "水准测量规范参数配置, 覆盖二等/三等/四等/等外",
    "source": "GB/T 12897-2006 (一、二等水准), GB/T 12898-2009 (三、四等水准)",
    "unit_convention": "SI单位(米/弧度)为主, 限差值标注原始单位",
    "status": "待人工复核S级规范原文"
  },
  "grade_2": {
    "_label": "二等水准测量",
    "_norm": "GB/T 12897-2006",
    "instrument": {
      "type": [
        "DS05",
        "DS1"
      ],
      "auto_level_compensator_error_arcsec": 0.2,
      "i_angle_limit_arcsec": 15.0
    },
    "rod": {
      "type": "invar_alloy",
      "material": "因瓦合金",
      "length_m": 3.0,
      "meter_interval_deviation_mm": 0.15,
      "line_type_meter_interval_deviation_mm": 0.1,
      "base_aux_constant_diff_m": 3.0155
    },
    "sight": {
      "max_length_m": 50.0,
      "max_station_distance_diff_m": 1.0,
      "max_cumulative_distance_diff_m": 3.0,
      "min_sight_height_from_ground_m": 0.3,
      "recommended_sight_height_m": 0.5
    },
    "reading_check": {
      "digital": {
        "base_aux_reading_diff_mm": 0.4,
        "base_aux_height_diff_mm": 0.6
      },
      "optical": {
        "base_aux_reading_diff_mm": 0.5,
        "base_aux_height_diff_mm": 0.7
      },
      "base_aux_reading_diff_mm": 0.4,
      "base_aux_height_diff_mm": 0.6,
      "_note": "数字/光学水准仪限差不同, 默认取数字水准仪值"
    },
    "closure": {
      "national_grade_mm": "4 * sqrt(L_km)",
      "national_grade_coefficient": 4.0,
      "engineering_flat_mm": "1.8 * sqrt(L_km)",
      "engineering_flat_coefficient": 1.8,
      "engineering_mountain_mm": "3.5 * sqrt(n_stations)",
      "engineering_mountain_coefficient": 3.5,
      "deformation_monitoring_mm": "0.30 * sqrt(n_stations)",
      "deformation_monitoring_coefficient": 0.3
    },
    "precision": {
      "per_station_height_diff_mean_error_mm": 0.15,
      "per_km_height_diff_accidental_mean_error_mm": 0.7
    },
    "recording": {
      "reading_precision_mm": 0.1,
      "height_diff_precision_mm": 0.01
    },
    "observation_program": {
      "stations_per_section": "even",
      "outbound_return_time": "different_periods",
      "same_period_max_station_ratio": 0.3,
      "turnplate_min_mass_kg": 5.0,
      "stake_min_mass_kg": 1.5,
      "stake_min_length_m": 0.2,
      "min_stakes": 4,
      "no_refocus_at_same_station": true
    },
    "simulation": {
      "sight_distance_range_m": [
        20.0,
        50.0
      ],
      "distance_diff_range_m": [
        -0.8,
        0.8
      ],
      "reading_perturbation_sigma_mm": 0.05,
      "base_aux_perturbation_sigma_mm": 0.15
    }
  },
