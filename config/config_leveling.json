  "height_datum": {
    "_description": "高程基准转换控制 (error_propagation.md A6)",
    "input_height_type": "normal_height",
    "_options": [
      "ellipsoid_height",
      "normal_height"
    ],
    "conversion_required": false,
    "_conversion_note": "若输入为椭球高, 必须提供高程异常 zeta 进行转换",
    "zeta_constant_assumption": true,
    "_zeta_note": "短路线近似: 假设 zeta 在路线范围内为常数, delta_zeta ≈ 0",
    "zeta_default_m": null,
    "_zeta_default_note": "null=不提供默认值, 用户必须显式指定或由数据源提供"
  },
  "feasibility_check": {
    "_description": "可行性预检参数 (error_propagation.md A7.1)",
    "threshold_multiplier": 3.0,
    "_threshold_note": "sigma_dh > 目标每站高差中误差 * 3 时发出警告",
    "math_true_value_mode": {
